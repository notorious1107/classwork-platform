{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["server/tests"]
}
