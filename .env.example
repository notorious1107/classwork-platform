PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/classwork.sqlite
# 首次创建数据库时是否写入演示账号、作业与答卷。正式使用前设为 false。
SEED_DEMO=true
# SEED_DEMO=false 时必须设置首次教师账号信息，密码至少 8 位。
# TEACHER_USERNAME=teacher
# TEACHER_PASSWORD=replace-with-a-strong-password
# TEACHER_NAME=数学老师
# CLASS_NAME=三年级（1）班
# HTTPS 部署时设为 true。纯 HTTP 本地体验保持 false。
COOKIE_SECURE=false
# 默认只接受当前网站来源的写入请求；跨域部署时可补充精确来源，逗号分隔。
# ALLOWED_ORIGINS=https://math.example.com
